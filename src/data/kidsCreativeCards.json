  "messages": [
    { "id": "msg-001", "categoryId": "birthday", "text": "Happy birthday to an absolutely amazing kid!" },
    { "id": "msg-002", "categoryId": "birthday", "text": "May your birthday be packed with cake, games, and giggles." },
    { "id": "msg-003", "categoryId": "birthday", "text": "You make every year brighter. Have the best birthday!" },
    { "id": "msg-004", "categoryId": "birthday", "text": "Make a wish and get ready for a fantastic new adventure." },
    { "id": "msg-005", "categoryId": "thank-you", "text": "Thank you for being so thoughtful and kind." },
    { "id": "msg-006", "categoryId": "thank-you", "text": "Your help meant more to me than you know." },
    { "id": "msg-007", "categoryId": "thank-you", "text": "A big thank-you wrapped in a giant hug!" },
    { "id": "msg-008", "categoryId": "thank-you", "text": "You made my day wonderful. Thank you!" },
    { "id": "msg-009", "categoryId": "congratulations", "text": "Congratulations—you worked hard and did it!" },
    { "id": "msg-010", "categoryId": "congratulations", "text": "What an awesome accomplishment. Be proud!" },
    { "id": "msg-011", "categoryId": "congratulations", "text": "Three cheers for your fantastic success!" },
    { "id": "msg-012", "categoryId": "congratulations", "text": "Your determination made this possible." },
    { "id": "msg-013", "categoryId": "friendship", "text": "Life is brighter with a friend like you." },
    { "id": "msg-014", "categoryId": "friendship", "text": "Thanks for every laugh and every adventure." },
    { "id": "msg-015", "categoryId": "friendship", "text": "You are the kind of friend everyone hopes to find." },
    { "id": "msg-016", "categoryId": "friendship", "text": "Friends like us make ordinary days extraordinary." },
    { "id": "msg-017", "categoryId": "get-well", "text": "Sending happy thoughts to help you feel better soon." },
    { "id": "msg-018", "categoryId": "get-well", "text": "Rest, recharge, and come back stronger." },
    { "id": "msg-019", "categoryId": "get-well", "text": "A hug, a smile, and lots of get-well wishes!" },
    { "id": "msg-020", "categoryId": "get-well", "text": "We miss your smile and hope you recover quickly." },
    { "id": "msg-021", "categoryId": "holidays", "text": "Wishing you a joyful holiday full of family fun." },
    { "id": "msg-022", "categoryId": "holidays", "text": "May your holidays sparkle from start to finish." },
    { "id": "msg-023", "categoryId": "holidays", "text": "Warm wishes for a magical and peaceful season." },
    { "id": "msg-024", "categoryId": "holidays", "text": "Have a holly-jolly time with everyone you love!" },
    { "id": "msg-025", "categoryId": "school", "text": "A new school day is a new chance to shine." },
    { "id": "msg-026", "categoryId": "school", "text": "Keep asking questions and discovering great things." },
    { "id": "msg-027", "categoryId": "school", "text": "You make your classroom a happier place." },
    { "id": "msg-028", "categoryId": "school", "text": "Here is to learning, growing, and making friends." },
    { "id": "msg-029", "categoryId": "family", "text": "Our family is better because you are in it." },
    { "id": "msg-030", "categoryId": "family", "text": "No matter where we go, family keeps us close." },
    { "id": "msg-031", "categoryId": "family", "text": "You fill our home with laughter and love." },
    { "id": "msg-032", "categoryId": "family", "text": "Together is our favorite place to be." },
    { "id": "msg-033", "categoryId": "encouragement", "text": "Believe in yourself as much as I believe in you." },
    { "id": "msg-034", "categoryId": "encouragement", "text": "Mistakes help your clever brain grow." },
    { "id": "msg-035", "categoryId": "encouragement", "text": "One brave step at a time—you have got this!" },
    { "id": "msg-036", "categoryId": "encouragement", "text": "Keep going. Your effort is already something to celebrate." },
    { "id": "msg-037", "categoryId": "sorry", "text": "I am sorry I hurt your feelings." },
    { "id": "msg-038", "categoryId": "sorry", "text": "I made a mistake and want to make it right." },
    { "id": "msg-039", "categoryId": "sorry", "text": "Our friendship matters more than being right." },
    { "id": "msg-040", "categoryId": "sorry", "text": "Please forgive me. I will try to do better." },
    { "id": "msg-041", "categoryId": "invitation", "text": "Come celebrate with games, treats, and lots of fun!" },
    { "id": "msg-042", "categoryId": "invitation", "text": "Save the date for a super-special day." },
    { "id": "msg-043", "categoryId": "invitation", "text": "Your smile is requested at our celebration!" },
    { "id": "msg-044", "categoryId": "invitation", "text": "Join the fun—we cannot wait to see you." },
    { "id": "msg-045", "categoryId": "teacher", "text": "Thank you for making learning an adventure." },
    { "id": "msg-046", "categoryId": "teacher", "text": "Your patience and kindness help me grow." },
    { "id": "msg-047", "categoryId": "teacher", "text": "Great teachers make big dreams feel possible." },
    { "id": "msg-048", "categoryId": "teacher", "text": "Thank you for seeing the best in every student." },
    { "id": "msg-049", "categoryId": "seasonal", "text": "Wishing you sunshine, fresh air, and seasonal fun." },
    { "id": "msg-050", "categoryId": "seasonal", "text": "Every season brings a brand-new reason to smile." },
    { "id": "msg-051", "categoryId": "seasonal", "text": "Enjoy the colors and wonders of the season." },
    { "id": "msg-052", "categoryId": "seasonal", "text": "A happy new season has arrived!" },
    { "id": "msg-053", "categoryId": "just-because", "text": "This card has one job: to make you smile." },
    { "id": "msg-054", "categoryId": "just-because", "text": "You crossed my mind, and it made me happy." },
    { "id": "msg-055", "categoryId": "just-because", "text": "No special reason—you are simply wonderful." },
    { "id": "msg-056", "categoryId": "just-because", "text": "A tiny hello for one of my favorite people." },
    { "id": "msg-057", "categoryId": "achievement", "text": "Your practice and patience paid off!" },
    { "id": "msg-058", "categoryId": "achievement", "text": "You set a goal, kept going, and reached it." },
    { "id": "msg-059", "categoryId": "achievement", "text": "This proud moment belongs to you." },
    { "id": "msg-060", "categoryId": "achievement", "text": "Keep learning, growing, and reaching for the stars." }
  ],
